            local SecTitle = Instance.new("TextLabel")
            SecTitle.Text = sectionTitle
            SecTitle.Font = Enum.Font.Garamond
            SecTitle.TextSize = 14
            SecTitle.TextColor3 = Color3.fromRGB(210, 170, 255)
            SecTitle.Position = UDim2.new(0, 10, 0, 6)
