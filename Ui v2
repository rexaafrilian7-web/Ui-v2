            -- Add Slider
            function SectionObj:AddSlider(text, min, max, default, callback)
                min = min or 0
                max = max or 100
                default = default or min
                callback = callback or function() end

                local SliderFrame = Instance.new("Frame")
                SliderFrame.Size = UDim2.new(1, 0, 0, 36)
                SliderFrame.BackgroundTransparency = 1
                SliderFrame.Parent = Container

                local Label = Instance.new("TextLabel")
                Label.Text = text .. ": " .. tostring(default)
                Label.Size = UDim2.new(1, 0, 0, 16)
                Label.Font = Enum.Font.Garamond
                Label.TextSize = 13
                Label.TextColor3 = Color3.fromRGB(210, 190, 235)
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.BackgroundTransparency = 1
                Label.Parent = SliderFrame

                local Track = Instance.new("Frame")
                Track.Size = UDim2.new(1, 0, 0, 8)
                Track.Position = UDim2.new(0, 0, 0, 20)
                Track.BackgroundColor3 = Color3.fromRGB(28, 20, 40)
                Track.BorderColor3 = Color3.fromRGB(90, 45, 150)
                Track.BorderSizePixel = 1
                Track.Parent = SliderFrame

                local TrackCorner = Instance.new("UICorner")
                TrackCorner.CornerRadius = UDim.new(0, 4)
                TrackCorner.Parent = Track

                local Fill = Instance.new("Frame")
                Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
                Fill.BackgroundColor3 = Color3.fromRGB(140, 70, 220)
                Fill.BorderSizePixel = 0
                Fill.Parent = Track

                local FillCorner = Instance.new("UICorner")
                FillCorner.CornerRadius = UDim.new(0, 4)
                FillCorner.Parent = Fill

                local isDragging = false
                local function updateValue(input)
                    local percent = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    local value = math.floor(min + (max - min) * percent)
                    Fill.Size = UDim2.new(percent, 0, 1, 0)
                    Label.Text = text .. ": " .. tostring(value)
                    callback(value)
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = true
                        updateValue(input)
                    end
                end)

                table.insert(Library.Connections, UserInputService.InputChanged:Connect(function(input)
                    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateValue(input)
                    end
                end))

                table.insert(Library.Connections, UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = false
                    end
                end))
            end

            -- Add Keybind
            function SectionObj:AddKeybind(text, defaultKey, callback)
                defaultKey = defaultKey or "Enum.KeyCode.E"
                callback = callback or function() end
                local currentKey = typeof(defaultKey) == "EnumItem" and defaultKey or Enum.KeyCode[tostring(defaultKey)]

                local KeyFrame = Instance.new("Frame")
                KeyFrame.Size = UDim2.new(1, 0, 0, 24)
                KeyFrame.BackgroundTransparency = 1
                KeyFrame.Parent = Container

                local Label = Instance.new("TextLabel")
                Label.Text = text
                Label.Size = UDim2.new(1, -60, 1, 0)
                Label.Font = Enum.Font.Garamond
                Label.TextSize = 13
                Label.TextColor3 = Color3.fromRGB(210, 190, 235)
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.BackgroundTransparency = 1
                Label.Parent = KeyFrame

                local KeyBtn = Instance.new("TextButton")
                KeyBtn.Size = UDim2.new(0, 55, 0, 20)
                KeyBtn.Position = UDim2.new(1, -55, 0, 2)
                KeyBtn.BackgroundColor3 = Color3.fromRGB(28, 20, 40)
                KeyBtn.BorderColor3 = Color3.fromRGB(100, 50, 160)
                KeyBtn.BorderSizePixel = 1
                KeyBtn.Text = currentKey and currentKey.Name or "None"
                KeyBtn.Font = Enum.Font.Garamond
                KeyBtn.TextSize = 11
                KeyBtn.TextColor3 = Color3.fromRGB(220, 200, 250)
                KeyBtn.Parent = KeyFrame

                local Corner = Instance.new("UICorner")
                Corner.CornerRadius = UDim.new(0, 4)
                Corner.Parent = KeyBtn

                local listening = false
                KeyBtn.MouseButton1Click:Connect(function()
                    listening = true
                    KeyBtn.Text = "..."
                end)

                table.insert(Library.Connections, UserInputService.InputBegan:Connect(function(input, gpe)
                    if gpe then return end
                    if listening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            currentKey = input.KeyCode
                            KeyBtn.Text = currentKey.Name
                            listening = false
                        end
                    elseif currentKey and input.KeyCode == currentKey then
                        callback(currentKey)
                    end
                end))
            end

            -- Add Dropdown (Updated & Fixed)
            function SectionObj:AddDropdown(text, options, default, callback, config)
                options = options or {}
                config = config or {}
                
                local isMultiSelect = config.MultiSelect or false
                local maxVisibleItems = config.MaxVisibleItems or 5
                local itemHeight = 30
                
                local selectedValue
                if isMultiSelect then
                    selectedValue = type(default) == "table" and default or (default and {default} or {})
                else
                    selectedValue = type(default) == "table" and default[1] or default or options[1] or ""
                end

                callback = callback or function() end

                local DropdownFrame = Instance.new("Frame")
                DropdownFrame.Name = text .. "_Dropdown"
                DropdownFrame.Size = UDim2.new(1, 0, 0, 42)
                DropdownFrame.BackgroundTransparency = 1
                DropdownFrame.Parent = Container

                local Label = Instance.new("TextLabel")
                Label.Text = text
                Label.Size = UDim2.new(1, 0, 0, 18)
                Label.Position = UDim2.new(0, 0, 0, 0)
                Label.Font = Enum.Font.Garamond
                Label.TextSize = 13
                Label.TextColor3 = Color3.fromRGB(210, 190, 235)
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.BackgroundTransparency = 1
                Label.Parent = DropdownFrame

                local DropdownBtn = Instance.new("TextButton")
                DropdownBtn.Size = UDim2.new(1, 0, 0, 24)
                DropdownBtn.Position = UDim2.new(0, 0, 0, 18)
                DropdownBtn.BackgroundColor3 = Color3.fromRGB(25, 18, 38)
                DropdownBtn.BorderColor3 = Color3.fromRGB(110, 60, 180)
                DropdownBtn.BorderSizePixel = 1
                DropdownBtn.Text = ""
                DropdownBtn.AutoButtonColor = false
                DropdownBtn.Parent = DropdownFrame

                local BtnUICorner = Instance.new("UICorner")
                BtnUICorner.CornerRadius = UDim.new(0, 5)
                BtnUICorner.Parent = DropdownBtn

                local SelectedTextLabel = Instance.new("TextLabel")
                SelectedTextLabel.Size = UDim2.new(1, -26, 1, 0)
                SelectedTextLabel.Position = UDim2.new(0, 8, 0, 0)
                SelectedTextLabel.Font = Enum.Font.Garamond
                SelectedTextLabel.TextSize = 12
                SelectedTextLabel.TextColor3 = Color3.fromRGB(200, 180, 230)
                SelectedTextLabel.TextXAlignment = Enum.TextXAlignment.Left
                SelectedTextLabel.TextTruncate = Enum.TextTruncate.AtEnd
                SelectedTextLabel.BackgroundTransparency = 1
                SelectedTextLabel.Parent = DropdownBtn

                local ArrowIcon = Instance.new("TextLabel")
                ArrowIcon.Size = UDim2.new(0, 20, 1, 0)
                ArrowIcon.Position = UDim2.new(1, -22, 0, 0)
                ArrowIcon.Text = "▼"
                ArrowIcon.Font = Enum.Font.Garamond
                ArrowIcon.TextSize = 10
                ArrowIcon.TextColor3 = Color3.fromRGB(160, 110, 230)
                ArrowIcon.BackgroundTransparency = 1
                ArrowIcon.Parent = DropdownBtn

                -- Floating Menu Dropdown
                local MenuHolder = Instance.new("Frame")
                MenuHolder.Name = text .. "_DropdownMenu"
                MenuHolder.BackgroundColor3 = Color3.fromRGB(20, 14, 30)
                MenuHolder.BorderColor3 = Color3.fromRGB(130, 70, 210)
                MenuHolder.BorderSizePixel = 1
                MenuHolder.Visible = false
                MenuHolder.ZIndex = 500
                MenuHolder.Parent = Library.ScreenGui

                local MenuUICorner = Instance.new("UICorner")
                MenuUICorner.CornerRadius = UDim.new(0, 6)
                MenuUICorner.Parent = MenuHolder

                local ScrollList = Instance.new("ScrollingFrame")
                ScrollList.Size = UDim2.new(1, -4, 1, -4)
                ScrollList.Position = UDim2.new(0, 2, 0, 2)
                ScrollList.BackgroundTransparency = 1
                ScrollList.BorderSizePixel = 0
                ScrollList.ScrollBarThickness = 4
                ScrollList.ScrollBarImageColor3 = Color3.fromRGB(140, 80, 220)
                ScrollList.CanvasSize = UDim2.new(0, 0, 0, 0)
                ScrollList.ZIndex = 501
                ScrollList.Parent = MenuHolder

                local UIListLayout = Instance.new("UIListLayout")
                UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
                UIListLayout.Padding = UDim.new(0, 2)
                UIListLayout.Parent = ScrollList

                local function updateDisplayText()
                    if isMultiSelect then
                        if #selectedValue == 0 then
                            SelectedTextLabel.Text = "Pilih..."
                        else
                            SelectedTextLabel.Text = table.concat(selectedValue, ", ")
                        end
                    else
                        SelectedTextLabel.Text = tostring(selectedValue)
                    end
                end

                local optionButtons = {}

                local function refreshOptionVisuals()
                    for optValue, btn in pairs(optionButtons) do
                        local isSelected = false
                        if isMultiSelect then
                            isSelected = table.find(selectedValue, optValue) ~= nil
                        else
                            isSelected = (selectedValue == optValue)
                        end

                        if isSelected then
                            btn.BackgroundColor3 = Color3.fromRGB(85, 40, 140)
                            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        else
                            btn.BackgroundColor3 = Color3.fromRGB(28, 20, 42)
                            btn.TextColor3 = Color3.fromRGB(190, 170, 220)
                        end
                    end
                end

                local function populateOptions(newOptions)
                    options = newOptions or options
                    for _, child in ipairs(ScrollList:GetChildren()) do
                        if child:IsA("TextButton") then
                            child:Destroy()
                        end
                    end
                    optionButtons = {}

                    for i, opt in ipairs(options) do
                        local ItemBtn = Instance.new("TextButton")
                        ItemBtn.Name = "Opt_" .. tostring(opt)
                        ItemBtn.Size = UDim2.new(1, -6, 0, itemHeight)
                        ItemBtn.Font = Enum.Font.Garamond
                        ItemBtn.TextSize = 12
                        ItemBtn.Text = "  " .. tostring(opt)
                        ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
                        ItemBtn.AutoButtonColor = false
                        ItemBtn.ZIndex = 502
                        ItemBtn.Parent = ScrollList

                        local ItemCorner = Instance.new("UICorner")
                        ItemCorner.CornerRadius = UDim.new(0, 4)
                        ItemCorner.Parent = ItemBtn

                        optionButtons[opt] = ItemBtn

                        ItemBtn.MouseButton1Click:Connect(function()
                            if isMultiSelect then
                                local index = table.find(selectedValue, opt)
                                if index then
                                    table.remove(selectedValue, index)
                                else
                                    table.insert(selectedValue, opt)
                                end
                            else
                                selectedValue = opt
                                MenuHolder.Visible = false
                                ArrowIcon.Text = "▼"
                            end

                            updateDisplayText()
                            refreshOptionVisuals()
                            callback(selectedValue)
                        end)
                    end

                    local totalItems = #options
                    local visibleCount = math.min(totalItems, maxVisibleItems)
                    local menuHeight = (visibleCount * (itemHeight + 2)) + 6
                    
                    MenuHolder.Size = UDim2.new(0, DropdownBtn.AbsoluteSize.X, 0, menuHeight)
                    ScrollList.CanvasSize = UDim2.new(0, 0, 0, totalItems * (itemHeight + 2))
                    refreshOptionVisuals()
                end

                DropdownBtn.MouseButton1Click:Connect(function()
                    MenuHolder.Visible = not MenuHolder.Visible
                    if MenuHolder.Visible then
                        ArrowIcon.Text = "▲"
                        local btnPos = DropdownBtn.AbsolutePosition
                        local btnSize = DropdownBtn.AbsoluteSize
                        MenuHolder.Position = UDim2.new(0, btnPos.X, 0, btnPos.Y + btnSize.Y + 4)
                        MenuHolder.Size = UDim2.new(0, btnSize.X, MenuHolder.Size.Y.Scale, MenuHolder.Size.Y.Offset)
                    else
                        ArrowIcon.Text = "▼"
                    end
                end)

                table.insert(Library.Connections, UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        if MenuHolder.Visible then
                            local mousePos = input.Position
                            local menuPos = MenuHolder.AbsolutePosition
                            local menuSize = MenuHolder.AbsoluteSize
                            local btnPos = DropdownBtn.AbsolutePosition
                            local btnSize = DropdownBtn.AbsoluteSize

                            local inMenu = mousePos.X >= menuPos.X and mousePos.X <= (menuPos.X + menuSize.X) and
                                           mousePos.Y >= menuPos.Y and mousePos.Y <= (menuPos.Y + menuSize.Y)

                            local inBtn = mousePos.X >= btnPos.X and mousePos.X <= (btnPos.X + btnSize.X) and
                                          mousePos.Y >= btnPos.Y and mousePos.Y <= (btnPos.Y + btnSize.Y)

                            if not inMenu and not inBtn then
                                MenuHolder.Visible = false
                                ArrowIcon.Text = "▼"
                            end
                        end
                    end
                end))

                populateOptions(options)
                updateDisplayText()

                return {
                    Set = function(val)
                        selectedValue = val
                        updateDisplayText()
                        refreshOptionVisuals()
                        callback(selectedValue)
                    end,
                    Refresh = function(newOptions)
                        populateOptions(newOptions)
                    end
                }
            end

            return SectionObj
        end

        return TabObj
    end

    return WindowObj
end

return Library
